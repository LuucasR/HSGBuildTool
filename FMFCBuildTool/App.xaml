<Application x:Class="FMFCBuildTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Theme/Typography.xaml"/>
                <ResourceDictionary Source="Resources/Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are app-wide so views don't each declare their own instance. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <views:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <views:InverseBoolConverter x:Key="InverseBool"/>
            <views:EqualsConverter x:Key="Equals"/>
            <views:SeverityToBrushConverter x:Key="SeverityToBrush"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>

<UserControl x:Class="FMFCBuildTool.Views.CommandletPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <!--
        Navigation page. The project and engine come from the shell, so there is no
        second project field to drift out of sync with Package, and no separate
        engine browser.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:PageHeader Title="Navigation"
                          Subtitle="Runs WorldPartitionNavigationDataBuilder once per selected map. Each map is a separate UnrealEditor-Cmd invocation, so one failing map doesn't take the rest down.">
            <views:PageHeader.Actions>
                <views:PresetPicker/>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionLabel}" Text="MAPS"/>

                <views:MapListControl Grid.Row="1" DataContext="{Binding MapSelection}"/>
            </Grid>
        </Border>

        <views:MapResultsPanel Grid.Row="2" Margin="20,0,20,12"/>

        <views:BuildActionBar Grid.Row="3"/>
    </Grid>
</UserControl>

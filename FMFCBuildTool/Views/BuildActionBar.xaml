<UserControl x:Class="FMFCBuildTool.Views.BuildActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             x:Name="Root"
             Style="{StaticResource AppControl}">

    <!--
        The footer of every build page. DataContext is the page's view-model, which has to
        satisfy IBuildPage.

        Package, Navigation and Lighting each carried their own copy of this markup, and
        the copies had already drifted: only Package showed elapsed time, only Package
        could save a .bat, and none of the three could open the log of the run it had just
        produced — for that you had to go to the log dock's toolbar. Stopping a build was a
        button labelled "Cancel" sitting immediately beside the one that starts it.

        ExtraActions is the one real difference between the pages: Package's "Save .bat".
    -->

    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0"
            Padding="20,12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================ COMMAND PREVIEW -->

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource MonoTextBox}"
                         MaxHeight="72"
                         Text="{Binding CommandPreview, Mode=OneWay}"/>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button Content="Copy"
                            Width="92"
                            Margin="0,0,0,6"
                            Command="{Binding CopyCommandLineCommand}"
                            ToolTip="Copy the command line to the clipboard"/>

                    <!-- Every page can export now, not just Package: a nightly navmesh
                         rebuild is a scheduled job, not something anyone wants to click. -->
                    <Button Content="Save .bat"
                            Width="92"
                            Command="{Binding SaveBatchFileCommand}"
                            ToolTip="Write this exact build out as a script, for CI or a scheduled task"/>

                    <ContentPresenter Content="{Binding ExtraActions, ElementName=Root}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ================================================ WHY RUN IS DISABLED -->

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Warning}"
                    BorderThickness="2,0,0,0"
                    CornerRadius="0,4,4,0"
                    Padding="10,6"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}">

                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconWarning}"
                          Width="13"
                          Height="13"
                          Stretch="Uniform"
                          Fill="Transparent"
                          Stroke="{StaticResource Warning}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Top"
                          Margin="0,2,8,0"/>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{StaticResource Warning}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ================================================ PROGRESS -->

            <ProgressBar Grid.Row="2"
                         Margin="0,0,0,10"
                         Value="{Binding Progress, Mode=OneWay}"
                         Maximum="100"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ================================================ STATUS + ACTIONS -->

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!--
                        The clock keeps its final value once the run ends, so the duration
                        of the build you just watched is still on screen.
                    -->
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ElapsedText, Converter={StaticResource StringToVisibility}}">

                        <Path Data="{StaticResource IconClock}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="Transparent"
                              Stroke="{StaticResource TextDim}"
                              StrokeThickness="1.3"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding ElapsedText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontSizeMono}"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!--
                        What history says this costs. A progress bar cannot know how long a
                        cook takes; the last four cooks of this project can.
                    -->
                    <TextBlock Text="{Binding EstimateText}"
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding EstimateText, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                    <ContentPresenter Content="{Binding ExtraToolButtons, ElementName=Root}"
                                      VerticalAlignment="Center"/>

                    <!-- "Send me the errors" happens the moment a build ends, which is here
                         and not in the log dock's toolbar. -->
                    <views:LogExportButton DataContext="{Binding LogExport}" Margin="0,0,6,0"/>

                    <Button Style="{StaticResource ToolButton}"
                            Margin="0,0,6,0"
                            Command="{Binding OpenLogFolderCommand}"
                            ToolTip="Open the folder holding the build logs">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}"/>
                            <TextBlock Text="Log folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}"
                            Margin="0,0,6,0"
                            Command="{Binding OpenLogFileCommand}"
                            ToolTip="Open the log file for this run">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFile}"/>
                            <TextBlock Text="Log file" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!--
                        Shown only while there is something to stop. An always-visible,
                        permanently greyed-out Cancel button beside BUILD was just noise.
                    -->
                    <Button Style="{StaticResource StopButton}"
                            Margin="0,0,14,0"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Kill the running process and every process it started">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconStop}"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="200"
                            Height="{StaticResource ControlHeightLarge}"
                            FontSize="14"
                            Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconPlay}"/>
                            <TextBlock Text="{Binding RunButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="FMFCBuildTool.Views.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quality and the preset belong to the title, not to the map list. -->
        <views:PageHeader Title="Lighting"
                          Subtitle="Runs ResavePackages -buildlighting once per selected map. This only produces work on projects that bake lighting — on a Lumen-only project each run finishes immediately with nothing to do.">
            <views:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Quality"/>
                    <ComboBox Width="130"
                              Margin="0,0,20,0"
                              ItemsSource="{Binding Qualities}"
                              SelectedItem="{Binding Quality}"/>

                    <views:PresetPicker/>
                </StackPanel>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionLabel}" Text="MAPS"/>

                <views:MapListControl Grid.Row="1" DataContext="{Binding MapSelection}"/>
            </Grid>
        </Border>

        <views:MapResultsPanel Grid.Row="2" Margin="20,0,20,12"/>

        <views:BuildActionBar Grid.Row="3"/>
    </Grid>
</UserControl>

<UserControl x:Class="FMFCBuildTool.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <UserControl.Resources>

        <!-- Chip moved to the theme; the shell's status bar needed the same pill. -->

        <Style x:Key="LogRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="10,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->

        <Border Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,7">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowInfo}">
                        <TextBlock>
                            <Run Text="All"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowWarnings}">
                        <TextBlock>
                            <Run Text="Warnings" Foreground="{StaticResource Warning}"/>
                            <Run Text="{Binding WarningCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowErrors}">
                        <TextBlock>
                            <Run Text="Errors" Foreground="{StaticResource Danger}"/>
                            <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                </StackPanel>

                <TextBox Grid.Column="1"
                         MinWidth="180"
                         MaxWidth="360"
                         HorizontalAlignment="Left"
                         Margin="12,0"
                         VerticalAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Filter lines and highlight matches"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <CheckBox Content="Follow"
                              IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Scroll to the newest line as output arrives"/>

                    <Button Style="{StaticResource ToolButton}"
                            Margin="0,0,6,0"
                            Command="{Binding CopyVisibleCommand}"
                            ToolTip="Copy the visible lines">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}"/>
                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy takes what the chips and the search box left on screen; Export
                         asks the severity question on its own, against the whole log. -->
                    <views:LogExportButton DataContext="{Binding LogExport}" Margin="0,0,6,0"/>

                    <Button Style="{StaticResource ToolButton}"
                            Content="Clear"
                            Margin="0,0,6,0"
                            Command="{Binding ClearCommand}"/>

                    <Button Style="{StaticResource ToolButton}"
                            Margin="0,0,6,0"
                            Command="{Binding OpenLogFileCommand}"
                            ToolTip="{Binding CurrentLogFile}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFile}"/>
                            <TextBlock Text="Log file" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}"
                            Margin="0,0,10,0"
                            Command="{Binding OpenLogFolderCommand}"
                            ToolTip="Open the folder holding the build logs">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}"/>
                            <TextBlock Text="Folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!--
                        The problems list. Hunting the one line that broke a 200,000-line
                        build by scrolling is the worst part of reading engine output.
                    -->
                    <ToggleButton Style="{StaticResource Chip}"
                                  Margin="0"
                                  IsChecked="{Binding ShowIssues}"
                                  ToolTip="Show the warnings and errors on their own (F8 jumps to the next)">
                        <TextBlock>
                            <Run Text="Issues"/>
                            <Run Text="{Binding Issues.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                </StackPanel>
            </Grid>
        </Border>

        <!-- LINES + ISSUES -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>

                <ListBox x:Name="LinesList"
                         ItemsSource="{Binding Lines}"
                         Background="{StaticResource Bg}"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource LogRow}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontSizeMono}"
                                       TextWrapping="NoWrap"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                       views:HighlightBehavior.Text="{Binding Text}"
                                       views:HighlightBehavior.Term="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <TextBlock Text="{Binding EmptyMessage}"
                           Foreground="{StaticResource TextDim}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>

            <!-- ============================================ PROBLEMS -->

            <Border Grid.Column="1"
                    Width="380"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowIssues, Converter={StaticResource BoolToVisibility}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,8,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"
                                   Text="{Binding IssuePositionText}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}"
                                    Height="22"
                                    Content="&#8593;"
                                    Command="{Binding PreviousIssueCommand}"
                                    ToolTip="Previous issue (Shift+F8)"/>

                            <Button Style="{StaticResource GhostButton}"
                                    Height="22"
                                    Content="&#8595;"
                                    Command="{Binding NextIssueCommand}"
                                    ToolTip="Next issue (F8)"/>

                            <Button Style="{StaticResource GhostButton}"
                                    Height="22"
                                    Content="Copy"
                                    Command="{Binding CopyIssuesCommand}"
                                    ToolTip="Copy every warning and error"/>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Issues}"
                             SelectedItem="{Binding SelectedIssue}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource LogRow}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Wrapped, not truncated: the message is the point here,
                                     unlike the log where alignment matters more. -->
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontSizeMono}"
                                           TextWrapping="Wrap"
                                           MaxHeight="52"
                                           Margin="0,3"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                           ToolTip="{Binding Text}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               Text="No warnings or errors."
                               Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>

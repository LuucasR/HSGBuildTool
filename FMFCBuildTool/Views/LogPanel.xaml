<UserControl x:Class="FMFCBuildTool.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views">

    <UserControl.Resources>

        <!--
            Severity chips. Independent toggles with live counts, so warnings and errors
            can be inspected together, and so the number of each is visible without
            scrolling the log.
        -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="10,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->

        <Border Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="12,7">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowInfo}">
                        <TextBlock>
                            <Run Text="All"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowWarnings}">
                        <TextBlock>
                            <Run Text="Warnings" Foreground="{StaticResource Warning}"/>
                            <Run Text="{Binding WarningCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowErrors}">
                        <TextBlock>
                            <Run Text="Errors" Foreground="{StaticResource Danger}"/>
                            <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </ToggleButton>

                </StackPanel>

                <TextBox Grid.Column="1"
                         MinWidth="180"
                         MaxWidth="360"
                         HorizontalAlignment="Left"
                         Margin="12,0"
                         VerticalAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Filter lines and highlight matches"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <CheckBox Content="Follow"
                              IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Scroll to the newest line as output arrives"/>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Copy"
                            Command="{Binding CopyVisibleCommand}"
                            ToolTip="Copy the visible lines"/>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Clear"
                            Command="{Binding ClearCommand}"/>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Log file"
                            Command="{Binding OpenLogFileCommand}"
                            ToolTip="{Binding CurrentLogFile}"/>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Folder"
                            Command="{Binding OpenLogFolderCommand}"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- LINES -->

        <Grid Grid.Row="1">

            <ListBox x:Name="LinesList"
                     ItemsSource="{Binding Lines}"
                     Background="{StaticResource Bg}"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource LogRow}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontSizeMono}"
                                   TextWrapping="NoWrap"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                   views:HighlightBehavior.Text="{Binding Text}"
                                   views:HighlightBehavior.Term="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock Text="{Binding EmptyMessage}"
                       Foreground="{StaticResource TextDim}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>
    </Grid>
</UserControl>

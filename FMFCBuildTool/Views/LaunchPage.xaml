<UserControl x:Class="FMFCBuildTool.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <UserControl.Resources>
        <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:PageHeader Title="Launch"
                          Subtitle="Runs the project as a game from UnrealEditor.exe with -game or -server, without opening the editor: the closest thing to the packaged build short of cooking. Each instance's log is followed into Output and kept in Saved\Logs\Launch."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============================================ WHAT TO RUN -->

                <Border Style="{StaticResource Card}" Margin="20,0,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="MAP AND MODE"/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Map" Width="90"/>
                            <ComboBox Width="420"
                                      Margin="0,0,10,0"
                                      ItemsSource="{Binding Maps}"
                                      SelectedItem="{Binding Map}"
                                      ToolTip="Every .umap under Content. The project default is GameDefaultMap, or ServerDefaultMap for a dedicated server."/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Rescan"
                                    Width="90"
                                    Command="{Binding RescanMapsCommand}"
                                    ToolTip="Look for maps in Content again"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" Width="90"/>
                            <!-- ItemTemplate rather than DisplayMemberPath: the shared ComboBox
                                 template draws the closed box from SelectionBoxItemTemplate. -->
                            <ComboBox Width="420"
                                      ItemsSource="{Binding Modes}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Mode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap"
                                   Margin="90,6,0,0"
                                   Text="{Binding ModeDescription}"/>

                        <StackPanel Style="{StaticResource Row}">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowsClients, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Clients" Width="90"/>
                                <ComboBox Width="70"
                                          Margin="0,0,24,0"
                                          ItemsSource="{Binding ClientCounts}"
                                          SelectedItem="{Binding ClientCount}"
                                          ToolTip="How many game clients to start"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowsConnectAddress, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Address"/>
                                <TextBox Width="160"
                                         Margin="0,0,24,0"
                                         Text="{Binding ConnectAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="IP or host name of the server to connect to"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowsPort, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Port"/>
                                <TextBox Width="80"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="-port= on the server; the port the clients connect to"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================ WINDOW -->

                <Border Style="{StaticResource Card}" Margin="20,0,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="WINDOW"/>

                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox Style="{StaticResource OptionCheck}"
                                      Content="Windowed"
                                      IsChecked="{Binding Windowed}"
                                      ToolTip="-windowed, or -fullscreen when unticked"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/>
                            <TextBox Width="64"
                                     Text="{Binding ResX, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Windowed}"
                                     ToolTip="-ResX="/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox Width="64"
                                     Margin="0,0,22,0"
                                     Text="{Binding ResY, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Windowed}"
                                     ToolTip="-ResY="/>

                            <CheckBox Style="{StaticResource OptionCheck}"
                                      Content="Tile windows across the screen"
                                      IsChecked="{Binding TileWindows}"
                                      IsEnabled="{Binding Windowed}"
                                      ToolTip="With more than one window, place them in a grid (-WinX/-WinY), shrunk to fit if needed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================ GAME AND SIMULATION -->

                <Border Style="{StaticResource Card}" Margin="20,0,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="GAME"/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="GameMode" Width="90"/>
                            <TextBox Width="320"
                                     Margin="0,0,24,0"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="{StaticResource FontSizeMono}"
                                     Text="{Binding GameMode, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="?game= override, e.g. /Script/MyGame.MyGameMode or a Blueprint class path. Empty uses the map's."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="URL options"/>
                            <TextBox Width="220"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="{StaticResource FontSizeMono}"
                                     Text="{Binding UrlOptions, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Appended to the map or connect URL, e.g. ?Name=Tester?Team=1"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Exec cmds" Width="90"/>
                            <TextBox Width="320"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="{StaticResource FontSizeMono}"
                                     Text="{Binding ExecCmds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="-ExecCmds: console commands run at startup, comma-separated, e.g. stat fps, stat unit"/>
                        </StackPanel>

                        <Separator/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="SIMULATION"/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RHI"/>
                            <ComboBox Width="110"
                                      Margin="0,0,24,0"
                                      ItemsSource="{Binding Rhis}"
                                      SelectedItem="{Binding Rhi}"
                                      ToolTip="-dx12, -dx11 or -vulkan. Default uses the project's setting."/>

                            <CheckBox Style="{StaticResource OptionCheck}"
                                      Content="No sound"
                                      IsChecked="{Binding NoSound}"
                                      ToolTip="-nosound — handy with several clients all playing audio at once"/>

                            <CheckBox Style="{StaticResource OptionCheck}"
                                      Content="Log console window"
                                      IsChecked="{Binding ShowLogConsole}"
                                      ToolTip="-log — each instance also opens its own log console, like a packaged build run with -log"/>

                            <CheckBox Style="{StaticResource OptionCheck}"
                                      Content="No Steam"
                                      IsChecked="{Binding NoSteam}"
                                      ToolTip="-nosteam — use the Null online subsystem, so local clients do not need Steam running"/>
                        </StackPanel>

                        <Separator/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="EXTRA ARGUMENTS"/>

                        <TextBox Margin="0,8,0,0"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="{StaticResource FontSizeMono}"
                                 Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Appended verbatim to every instance, e.g. -NoVerifyGC -FPS=60"/>
                    </StackPanel>
                </Border>

                <!-- ============================================ INSTANCES -->

                <Border Style="{StaticResource Card}" Margin="20,0,20,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="INSTANCES"/>

                        <TextBlock Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextDim}"
                                   Margin="0,8,0,0"
                                   Text="Nothing launched yet."
                                   Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <ItemsControl ItemsSource="{Binding Instances}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{StaticResource TextDim}"
                                                   Text="{Binding ProcessId, StringFormat=pid {0}}"/>
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{StaticResource TextDim}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding LogFile}"
                                                   ToolTip="{Binding LogFile}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================================================ ACTION BAR
             Its own rather than BuildActionBar, which binds to IBuildPage: a launch has
             no progress, no outcome and no single process to time. -->

        <Border Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Style="{StaticResource MonoTextBox}"
                             MaxHeight="96"
                             Text="{Binding CommandPreview, Mode=OneWay}"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Button Content="Copy"
                                Width="92"
                                Margin="0,0,0,6"
                                Command="{Binding CopyCommandLineCommand}"
                                ToolTip="Copy the command lines to the clipboard"/>
                        <Button Content="Save .bat"
                                Width="92"
                                Command="{Binding SaveBatchFileCommand}"
                                ToolTip="Write a script that starts the same instances, for anyone without the tool"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Warning}"
                        BorderThickness="2,0,0,0"
                        CornerRadius="0,4,4,0"
                        Padding="10,6"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{StaticResource Warning}"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolButton}"
                                Margin="0,0,6,0"
                                Command="{Binding OpenLogFolderCommand}"
                                ToolTip="Open Saved\Logs\Launch, where each instance writes its log">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}"/>
                                <TextBlock Text="Log folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource StopButton}"
                                Margin="0,0,14,0"
                                Command="{Binding StopAllCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Close every instance this page started">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconStop}"/>
                                <TextBlock Text="Stop all" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}"
                                MinWidth="200"
                                Height="{StaticResource ControlHeightLarge}"
                                FontSize="14"
                                Command="{Binding LaunchCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconPlay}"/>
                                <TextBlock Text="LAUNCH" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

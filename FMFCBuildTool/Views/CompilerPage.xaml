<UserControl x:Class="FMFCBuildTool.Views.CompilerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <UserControl.Resources>

        <!-- The three configurations read as a choice, not as a dropdown to go hunting in. -->
        <Style x:Key="ConfigChoice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="CompileConfiguration"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            The same name the Package and HLOD pages use for their option checkboxes, but
            stacked rather than in a row: each of these needs a paragraph under it saying
            what it costs, so they cannot sit side by side.
        -->
        <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:PageHeader Title="Compiler"
                          Subtitle="Runs UnrealBuildTool on the project's C++ code, and can follow it by compiling every Blueprint. Compile before queueing a package build, so a class that never got built fails here in seconds instead of halfway through a cook."/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12" VerticalAlignment="Top">
            <StackPanel>

                <!-- ============================================ TARGET -->

                <TextBlock Style="{StaticResource SectionLabel}" Text="TARGET"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Target"/>

                    <ComboBox Width="260"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding Target}"
                              ToolTip="Read from the .Target.cs files in the project's Source folder"/>

                    <!-- Targets are scanned when the project opens; this is for one added since. -->
                    <Button Style="{StaticResource GhostButton}"
                            Content="Rescan"
                            Width="90"
                            Command="{Binding RescanTargetsCommand}"
                            ToolTip="Look at Source\*.Target.cs again"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Platform" Margin="24,0,10,0"/>
                    <TextBlock Text="Win64" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Text="{Binding TargetSummary}"/>

                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"
                           Text="The editor target is what the editor loads, so it is the one to build after adding or changing a class. The game target is what a package build compiles."/>

                <!-- ============================================ CONFIGURATION -->

                <TextBlock Style="{StaticResource SectionLabel}" Text="CONFIGURATION"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                    <!--
                        Equals converts both ways — ConvertBack hands back the parameter on
                        check and Binding.DoNothing on uncheck — so the group needs no
                        command of its own.
                    -->
                    <RadioButton Style="{StaticResource ConfigChoice}"
                                 Content="Debug"
                                 IsChecked="{Binding Configuration, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Debug}"
                                 ToolTip="Debuggable game code (DebugGame). Slow, but breakpoints land where you put them."/>

                    <RadioButton Style="{StaticResource ConfigChoice}"
                                 Content="Development"
                                 IsChecked="{Binding Configuration, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Development}"
                                 ToolTip="The everyday configuration, and what the editor runs"/>

                    <RadioButton Style="{StaticResource ConfigChoice}"
                                 Content="Shipping"
                                 IsChecked="{Binding Configuration, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Shipping}"
                                 ToolTip="Optimised, no logging or console. Game targets only — an editor target cannot build Shipping."/>
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"
                           Text="Debug builds as DebugGame: real Debug needs an engine compiled in Debug, which a Launcher install is not."/>

                <Separator/>

                <!-- ============================================ BLUEPRINTS -->

                <TextBlock Style="{StaticResource SectionLabel}" Text="AFTER COMPILING"/>

                <CheckBox Style="{StaticResource OptionCheck}"
                          Margin="0,8,0,0"
                          Content="Update Blueprints?"
                          IsChecked="{Binding UpdateBlueprints}"
                          ToolTip="-run=CompileAllBlueprints. Adds an editor start-up to every compile, and a failing Blueprint now fails the build — which stops a queued Compile → Package."/>

                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"
                           Text="Runs the editor's CompileAllBlueprints commandlet once the C++ build succeeds, and lists the Blueprints that failed. It compiles in memory: nothing is saved, so this reports the damage rather than repairing it. Not the same as opening the editor, which only recompiles what is out of date — this compiles every Blueprint, every time."/>

                <!-- Useless on its own: it works from the failures of the step above. -->
                <CheckBox Style="{StaticResource OptionCheck}"
                          Content="Update all nodes in Blueprint?"
                          IsEnabled="{Binding UpdateBlueprints}"
                          IsChecked="{Binding UpdateAllNodesInBlueprints}"
                          ToolTip="Runs a generated Python script through -run=pythonscript. This one writes to your project."/>

                <!--
                    This caption has to be blunt about the gap. "Refresh All Nodes" in the
                    Blueprint editor is FBlueprintEditorUtils::RefreshAllNodes, which 5.7
                    does not expose to script at all — compile_blueprint() only compiles,
                    with SkipSave. Loading the asset is what repairs, and it repairs less.
                -->
                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"
                           Text="For each Blueprint that failed above, loads it in a fresh editor, compiles it again and SAVES the asset. The load is what repairs a reference left stale by a changed struct. This is not the editor's Refresh All Nodes, which Unreal does not expose to scripting — a Blueprint that needs a real node reconstruction will still come back as failing and has to be opened by hand. Needs the Python Editor Script plugin enabled, and the editor closed, or the saves fail."/>

                <CheckBox Style="{StaticResource OptionCheck}"
                          Content="Skip engine content"
                          IsEnabled="{Binding UpdateBlueprints}"
                          IsChecked="{Binding BlueprintSkipEngineContent}"
                          ToolTip="-IgnoreFolder=/Engine,/Script — skips content this project could not fix even if it is broken"/>

                <TextBlock Style="{StaticResource Caption}"
                           Foreground="{StaticResource TextDim}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"
                           Text="Untick to compile engine Blueprints too. Slower, and what it finds is not yours to fix. Note that plugin content is compiled either way — -IgnoreFolder is a blocklist, so it cannot express &quot;only /Game&quot; — but plugin failures are counted rather than listed."/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Extra arguments" Margin="0,4,0,0"/>

                <TextBox Margin="0,4,0,0"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="{StaticResource FontSizeMono}"
                         Text="{Binding BlueprintExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Appended verbatim to both Blueprint invocations. The commandlet's own filtering switches are undocumented and Unreal ignores unknown ones silently, so the tool sends none — this is where to try yours."/>

            </StackPanel>
        </Border>

        <views:BlueprintResultsPanel Grid.Row="2" Margin="20,0,20,12" VerticalAlignment="Top"/>

        <views:BuildActionBar Grid.Row="3"/>
    </Grid>
</UserControl>

<Window x:Class="FMFCBuildTool.Views.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New preset"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource Card}" CornerRadius="0" BorderThickness="0" Background="{StaticResource Bg}" Padding="20">
        <StackPanel>

            <TextBlock Style="{StaticResource H2}" Text="Save preset as"/>

            <TextBlock Style="{StaticResource Caption}"
                       Margin="0,4,0,14"
                       TextWrapping="Wrap"
                       Text="Presets are stored per project, so each .uproject keeps its own set."/>

            <TextBox x:Name="NameTextBox"
                     Height="32"
                     KeyDown="NameTextBox_KeyDown"/>

            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource Caption}"
                       Foreground="{StaticResource Danger}"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button Width="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True"/>

                <Button Width="90"
                        Style="{StaticResource PrimaryButton}"
                        Content="Save"
                        IsDefault="True"
                        Click="Save_Click"/>

            </StackPanel>

        </StackPanel>
    </Border>

</Window>

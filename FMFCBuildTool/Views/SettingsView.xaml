<UserControl x:Class="FMFCBuildTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- ============================================ ENGINE -->

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Unreal Engine"/>

                    <TextBlock Style="{StaticResource Caption}"
                               Margin="0,4,0,14"
                               TextWrapping="Wrap"
                               Text="The engine is normally resolved from the project's EngineAssociation, via the registry, the Epic Games Launcher manifest, registered source builds, and conventional install paths. Set an override only when that fails."/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Resolved" VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResolvedEngineSummary}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Override"/>

                        <TextBox Grid.Column="1" Text="{Binding EnginePathOverride, UpdateSourceTrigger=LostFocus}"/>

                        <Button Grid.Column="2" Content="Browse…" Width="86" Margin="8,0,0,0" Command="{Binding BrowseEngineCommand}"/>
                        <Button Grid.Column="3" Content="Clear" Width="72" Margin="6,0,0,0" Command="{Binding ClearEngineOverrideCommand}"/>
                    </Grid>

                    <Grid Margin="0,10,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="DETECTED INSTALLATIONS" Margin="0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Rescan"
                                HorizontalAlignment="Right"
                                Command="{Binding RescanEnginesCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DetectedEngines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAlt}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Version, StringFormat='UE {0}'}"
                                                   FontWeight="SemiBold"
                                                   Width="72"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Root}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Use this"
                                                Width="82"
                                                Command="{Binding DataContext.UseEngineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Foreground="{StaticResource TextDim}"
                               Margin="0,4,0,0"
                               Text="No installations detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetectedEngines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- ============================================ DEFAULTS -->

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Defaults"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Archive root"/>

                        <TextBox Grid.Column="1" Text="{Binding DefaultArchiveRoot, UpdateSourceTrigger=LostFocus}"/>

                        <Button Grid.Column="2" Content="Browse…" Width="86" Margin="8,0,0,0" Command="{Binding BrowseArchiveRootCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}"
                               Foreground="{StaticResource TextDim}"
                               Margin="0,6,0,0"
                               Text="Used as the starting folder when browsing for a build's archive directory."/>

                </StackPanel>
            </Border>

            <!-- ============================================ STORAGE -->

            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Logs and settings"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Keep build logs for"/>
                        <ComboBox Width="100"
                                  ItemsSource="{Binding RetentionOptions}"
                                  SelectedItem="{Binding LogRetentionDays}"/>
                        <TextBlock Text="days" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Settings file"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConfigPath}"
                                   Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Content="Reveal" Width="82" Command="{Binding RevealConfigCommand}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Log folder"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding LogDirectory}"
                                   Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Content="Reveal" Width="82" Command="{Binding RevealLogsCommand}"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="FMFCBuildTool.Views.MapResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource AppControl}"
             Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">

    <!--
        Per-map outcome for the run in progress or the one that just finished. DataContext
        is a CommandletPageViewModel.

        Before this the result of a five-map run was one line of log text, so retrying the
        two that failed meant re-running all five and sitting through the three that had
        already worked. "Retry failed" is the point of the panel; the list is what makes it
        obvious what it will do.
    -->

    <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource SectionLabel}" Text="RESULTS" Margin="0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource Caption}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ResultsSummary}"/>

                <Button Grid.Column="2"
                        Style="{StaticResource ToolButton}"
                        Command="{Binding RetryFailedCommand}"
                        ToolTip="Re-run only the maps that failed or never started">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconPlay}"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Retry failed"/>
                            <Run Text="{Binding FailedCount, Mode=OneWay, StringFormat=({0})}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Results}"
                      MaxHeight="220"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="Map" Width="240" DisplayMemberBinding="{Binding Name}"/>

                        <GridViewColumn Header="Result" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Time" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DurationText}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSizeMono}"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Package path" Width="520">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Map}"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Map}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Border>
</UserControl>

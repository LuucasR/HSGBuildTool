<UserControl x:Class="FMFCBuildTool.Views.PackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views">

    <UserControl.Resources>

        <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,20,6"/>
        </Style>

        <Style x:Key="PipelineStep" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <Style x:Key="PipelineArrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="&#8250;"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================================ PRESETS -->

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Preset"/>

                        <!--
                            An explicit ItemTemplate rather than DisplayMemberPath: the custom
                            ComboBox template renders the closed box through SelectionBoxItemTemplate,
                            which DisplayMemberPath does not populate, so the box showed the type name.
                        -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  ToolTip="Presets are saved per project">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Save" Width="72" Margin="0,0,6,0" Command="{Binding SavePresetCommand}"/>
                            <Button Content="Save as&#8230;" Width="90" Margin="0,0,6,0" Command="{Binding SaveAsPresetCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="Delete" Width="72" Command="{Binding DeletePresetCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ OPTIONS -->

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>

                        <!-- TARGET -->

                        <TextBlock Style="{StaticResource SectionLabel}" Text="TARGET"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Platform"/>
                            <ComboBox Width="130"
                                      Margin="0,0,20,0"
                                      ItemsSource="{Binding Platforms}"
                                      SelectedItem="{Binding Platform}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Configuration"/>
                            <ComboBox Width="150"
                                      Margin="0,0,24,0"
                                      ItemsSource="{Binding Configurations}"
                                      SelectedItem="{Binding Configuration}"/>

                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0,0,20,0" Content="Client" IsChecked="{Binding Client}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0" Content="Server" IsChecked="{Binding Server}"/>
                        </StackPanel>

                        <Separator/>

                        <!--
                            PIPELINE. Build, Cook, Stage, Package and Archive are a sequence, so
                            they read as one. These five used to be five checkboxes among twenty-three.
                        -->

                        <TextBlock Style="{StaticResource SectionLabel}" Text="PIPELINE" Margin="0,10,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                            <Border Style="{StaticResource PipelineStep}">
                                <CheckBox Content="Build" Margin="0" IsChecked="{Binding Build}"/>
                            </Border>
                            <TextBlock Style="{StaticResource PipelineArrow}"/>

                            <Border Style="{StaticResource PipelineStep}">
                                <CheckBox Content="Cook" Margin="0" IsChecked="{Binding Cook}"/>
                            </Border>
                            <TextBlock Style="{StaticResource PipelineArrow}"/>

                            <Border Style="{StaticResource PipelineStep}">
                                <CheckBox Content="Stage" Margin="0" IsChecked="{Binding Stage}"/>
                            </Border>
                            <TextBlock Style="{StaticResource PipelineArrow}"/>

                            <Border Style="{StaticResource PipelineStep}">
                                <CheckBox Content="Package" Margin="0" IsChecked="{Binding Package}"/>
                            </Border>
                            <TextBlock Style="{StaticResource PipelineArrow}"/>

                            <Border Style="{StaticResource PipelineStep}">
                                <CheckBox Content="Archive" Margin="0" IsChecked="{Binding Archive}"/>
                            </Border>

                        </StackPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Archive folder"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding ArchiveDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Archive}"/>

                            <Button Grid.Column="2"
                                    Content="Browse&#8230;"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding Archive}"
                                    Command="{Binding BrowseArchiveCommand}"/>
                        </Grid>

                        <Separator Margin="0,12,0,0"/>

                        <!-- COOK -->

                        <TextBlock Style="{StaticResource SectionLabel}" Text="COOK" Margin="0,10,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mode"/>
                            <RadioButton Content="Modified only" Margin="0,0,20,0" IsChecked="{Binding ModifiedCook}"/>
                            <RadioButton Content="Full cook (-clean)" Margin="0,0,28,0" IsChecked="{Binding FullCook}"/>

                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0,0,20,0" Content="Incremental" IsChecked="{Binding CookIncremental}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0,0,20,0" Content="Zen Store" IsChecked="{Binding ZenStore}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0,0,20,0" Content="Skip editor content" IsChecked="{Binding SkipCookingEditorContent}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Margin="0" Content="Unversioned" IsChecked="{Binding UnversionedCookedContent}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cultures" VerticalAlignment="Top" Margin="0,4,12,0"/>

                            <!-- Multi-select: the model has always held a list, the old combo could only pick one. -->
                            <ItemsControl ItemsSource="{Binding Cultures}" MaxWidth="820">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Code}"
                                                  ToolTip="{Binding Display}"
                                                  IsChecked="{Binding Selected}"
                                                  Margin="0,0,16,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Margin="0,10,0,0"/>

                        <!-- PACKAGING -->

                        <TextBlock Style="{StaticResource SectionLabel}" Text="PACKAGING" Margin="0,10,0,8"/>

                        <WrapPanel>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="Pak" IsChecked="{Binding Pak}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="IoStore" IsChecked="{Binding IoStore}"
                                      ToolTip="Was unreachable from the old UI: the value was hardcoded to false."/>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="Compressed" IsChecked="{Binding Compressed}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="Prerequisites" IsChecked="{Binding Prereqs}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="Distribution" IsChecked="{Binding Distribution}"/>
                            <CheckBox Style="{StaticResource OptionCheck}" Content="Crash reporter" IsChecked="{Binding CrashReporter}"/>
                        </WrapPanel>

                        <Separator Margin="0,4,0,0"/>

                        <!--
                            ADVANCED. Collapsed by default: seven flags that are almost never
                            touched used to sit at the same visual weight as Cook and Archive.
                        -->

                        <Expander Header="Advanced / logging" Margin="0,6,0,0">
                            <WrapPanel Margin="0,4,0,4">
                                <CheckBox Style="{StaticResource OptionCheck}" Content="No compile" IsChecked="{Binding NoCompile}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="No compile editor" IsChecked="{Binding NoCompileEditor}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="File open log" IsChecked="{Binding FileOpenLog}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="StdOut" IsChecked="{Binding StdOut}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="Crash for UAT" IsChecked="{Binding CrashForUAT}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="Unattended" IsChecked="{Binding Unattended}"/>
                                <CheckBox Style="{StaticResource OptionCheck}" Content="No log times" IsChecked="{Binding NoLogTimes}"/>
                            </WrapPanel>
                        </Expander>

                    </StackPanel>
                </Border>

                <!-- ============================================ MAPS -->

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid Height="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="MAPS" Margin="0" VerticalAlignment="Center"/>

                            <CheckBox HorizontalAlignment="Right"
                                      Margin="0"
                                      Content="Use the project's default maps"
                                      IsChecked="{Binding UseProjectDefaultMaps}"
                                      ToolTip="When on, no -map= argument is passed and the project's own default map list is cooked."/>
                        </Grid>

                        <views:MapListControl Grid.Row="1"
                                              DataContext="{Binding MapSelection}"
                                              IsEnabled="{Binding DataContext.UseProjectDefaultMaps,
                                                          RelativeSource={RelativeSource AncestorType=UserControl},
                                                          Converter={StaticResource InverseBool}}"/>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ============================================ COMMAND + ACTIONS -->

        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Exactly what will run, before it runs. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Style="{StaticResource MonoTextBox}"
                             MaxHeight="72"
                             Text="{Binding CommandPreview, Mode=OneWay}"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Button Content="Copy" Width="82" Margin="0,0,0,6" Command="{Binding CopyCommandLineCommand}"/>
                        <Button Content="Save .bat" Width="82" Command="{Binding SaveBatchFileCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Why BUILD is disabled, stated instead of implied. -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Warning}"
                        BorderThickness="2,0,0,0"
                        Padding="10,6"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{StaticResource Warning}"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="110"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding CancelCommand}"/>

                        <Button Style="{StaticResource PrimaryButton}"
                                Content="BUILD"
                                Width="180"
                                Height="34"
                                FontSize="14"
                                Command="{Binding BuildCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

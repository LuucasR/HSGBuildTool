<UserControl x:Class="FMFCBuildTool.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Style="{StaticResource AppControl}">

    <!--
        Says which page you are on. The rail marks the active item, but nothing on the
        page itself named it, and only two of the five pages carried any description at
        all — as a full Card, which gave a paragraph of explanatory text the same visual
        weight as the maps list below it.

        Actions is for the one control that belongs to the title rather than to the body,
        such as Lighting's quality picker.
    -->

    <Grid Margin="20,16,20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title, ElementName=Root}"/>

            <TextBlock Style="{StaticResource Caption}"
                       Margin="0,4,0,0"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle, ElementName=Root}"
                       Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource StringToVisibility}}"/>
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"
                          Content="{Binding Actions, ElementName=Root}"/>
    </Grid>
</UserControl>

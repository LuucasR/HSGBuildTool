<UserControl x:Class="FMFCBuildTool.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FMFCBuildTool.Views"
             Style="{StaticResource AppPage}">

    <!--
        Chains the three build pages. Only one process may run at a time by design, which
        used to mean waiting out a cook in order to click BUILD NAVIGATION and then waiting
        again. This runs them in order and reports each one.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:PageHeader Title="Queue"
                          Subtitle="Runs the selected builds back to back, in the order you tick them, using each page's own settings. Every step writes its own log, exactly as if you had run it by hand."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>

                                    <!-- The card order already is the run order; the number
                                         says so out loud, and reads at a glance. -->
                                    <Border Grid.Column="1"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentSubtle}"
                                            Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="{Binding PositionLabel}"
                                                   Foreground="{StaticResource Accent}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Label}"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Description}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StateLabel}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <CheckBox Content="Stop the queue at the first failure"
                                  IsChecked="{Binding StopOnFailure}"
                                  Margin="0"/>

                        <TextBlock Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextDim}"
                                   Margin="24,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Off, the queue carries on to the next step. A step whose own validation is failing is always skipped rather than run and reported as a success."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Style="{StaticResource StopButton}"
                            Margin="0,0,14,0"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Stop the step in flight and abandon the rest of the queue">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconStop}"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="200"
                            Height="{StaticResource ControlHeightLarge}"
                            FontSize="14"
                            Command="{Binding RunQueueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIconFilled}" Data="{StaticResource IconPlay}"/>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="RUN QUEUE"/>
                                <Run Text="{Binding EnabledCount, Mode=OneWay, StringFormat=({0})}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

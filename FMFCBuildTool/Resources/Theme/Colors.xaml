<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette tokens. Every colour in the app comes from here — the previous theme
        defined six brushes and then hardcoded the rest inline across the views, so
        the same grey existed as three slightly different values.

        Contrast: Text and TextMuted both clear 4.5:1 against Bg, Surface and SurfaceAlt.
    -->

    <!-- ===== Elevation ===== -->
    <Color x:Key="BgColor">#FF0D1117</Color>
    <Color x:Key="SurfaceColor">#FF161B22</Color>
    <Color x:Key="SurfaceAltColor">#FF1C2129</Color>
    <Color x:Key="SurfaceHoverColor">#FF232A33</Color>
    <Color x:Key="InputColor">#FF0D1117</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="Input" Color="{StaticResource InputColor}"/>

    <!-- ===== Lines ===== -->
    <Color x:Key="BorderColor">#FF30363D</Color>
    <Color x:Key="BorderStrongColor">#FF484F58</Color>

    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>

    <!-- ===== Accent ===== -->
    <Color x:Key="AccentColor">#FF4CC2FF</Color>
    <Color x:Key="AccentHoverColor">#FF6FD0FF</Color>
    <Color x:Key="AccentPressedColor">#FF33A9E6</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#332F81A8"/>

    <!-- ===== Semantic ===== -->
    <SolidColorBrush x:Key="Success" Color="#FF3FB950"/>
    <SolidColorBrush x:Key="Warning" Color="#FFD29922"/>
    <SolidColorBrush x:Key="Danger" Color="#FFF85149"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFFF6A61"/>

    <!-- Log text runs slightly brighter than the status colours so long lines stay legible. -->
    <SolidColorBrush x:Key="LogInfo" Color="#FFE6EDF3"/>
    <SolidColorBrush x:Key="LogWarning" Color="#FFE3B341"/>
    <SolidColorBrush x:Key="LogError" Color="#FFFF7B72"/>
    <SolidColorBrush x:Key="LogVerbose" Color="#FF7D8590"/>
    <SolidColorBrush x:Key="LogHighlight" Color="#66D29922"/>

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="Text" Color="#FFE6EDF3"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF9AA5B1"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF6E7681"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FF06121C"/>

    <SolidColorBrush x:Key="Transparent" Color="Transparent"/>

</ResourceDictionary>

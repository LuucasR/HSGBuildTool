<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icon geometry, all drawn on the same 16x16 box and in the same language as the
        nav rail's icons: thin strokes, round joins, no fills except where an icon is
        meant to read as a solid (stop, play). Kept as Geometry resources rather than
        inline Path.Data strings so the same glyph cannot drift between two buttons.

        Pair a stroked glyph with ButtonIcon and a solid one with ButtonIconFilled.
    -->

    <!-- ===== Stroked ===== -->
    <Geometry x:Key="IconFolder">M1.8 4 A0.7 0.7 0 0 1 2.5 3.3 H6.2 L7.7 5.3 H13.5 A0.7 0.7 0 0 1 14.2 6 V12.5 A0.7 0.7 0 0 1 13.5 13.2 H2.5 A0.7 0.7 0 0 1 1.8 12.5 Z</Geometry>
    <Geometry x:Key="IconFile">M4 2.2 H9.4 L12.2 5 V13.8 H4 Z M9.4 2.2 V5 H12.2 M6 8.4 H10.2 M6 11 H10.2</Geometry>
    <Geometry x:Key="IconCopy">M5.8 5.8 H13.2 V13.2 H5.8 Z M3.4 10.2 V3.4 A0.6 0.6 0 0 1 4 2.8 H10.2</Geometry>
    <Geometry x:Key="IconClock">M8 2.2 A5.8 5.8 0 1 0 8.01 2.2 Z M8 4.8 V8.2 L10.4 9.6</Geometry>
    <Geometry x:Key="IconError">M8 2.2 A5.8 5.8 0 1 0 8.01 2.2 Z M8 5.2 V8.6 M8 10.8 V11.3</Geometry>
    <Geometry x:Key="IconWarning">M8 2.4 L14.2 13.2 H1.8 Z M8 6.4 V9.4 M8 11.2 V11.7</Geometry>
    <Geometry x:Key="IconCheck">M3.2 8.4 L6.4 11.6 L12.8 4.8</Geometry>

    <!-- ===== Solid ===== -->
    <Geometry x:Key="IconStop">M4.8 4.8 H11.2 V11.2 H4.8 Z</Geometry>
    <Geometry x:Key="IconPlay">M5.4 3.4 L12.6 8 L5.4 12.6 Z</Geometry>
    <Geometry x:Key="IconDot">M8 5 A3 3 0 1 0 8.01 5 Z</Geometry>
    <Geometry x:Key="IconExport">M8 2.6 V9.8 M5 7 L8 10 L11 7 M3.2 12.8 H12.8</Geometry>
    <Geometry x:Key="IconCaretDown">M4.6 6.6 L8 10 L11.4 6.6</Geometry>

    <!--
        Icon inside a button. Stroke follows the button's Foreground, so it dims with the
        button on IsEnabled=False instead of staying bright over faded text.
    -->
    <Style x:Key="ButtonIcon" TargetType="Path">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <Style x:Key="ButtonIconFilled" TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
    </Style>

</ResourceDictionary>
